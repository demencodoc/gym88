APP_NAME="Gym 88"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------
# Database — MySQL cho staging/production
# ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gym88
DB_USERNAME=gym88_user
DB_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------
# Payment — VietQR & Webhook
# ---------------------------------------------------------
PAYMENT_WEBHOOK_SECRET=change_me_to_a_long_random_secret

VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NUMBER=0901234567
VIETQR_ACCOUNT_NAME=HOI GYM 88
VIETQR_TEMPLATE=compact2

# ---------------------------------------------------------
# Cloud Storage — S3/R2 (để trống khi dùng local disk)
# ---------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# USE_X_ACCEL_REDIRECT=false

# ---------------------------------------------------------
# Mail — dùng log cho dev, SMTP/Resend cho production
# ---------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@gym88.vn"
MAIL_FROM_NAME="${APP_NAME}"

# Password Reset
# RESEND_API_KEY=

# ---------------------------------------------------------
# Sanctum — Token expiry (giây). 0 = không hết hạn
# ---------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=0

VITE_APP_NAME="${APP_NAME}"
